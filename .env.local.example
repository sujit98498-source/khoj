# ── Firebase (client-side) ────────────────────────────────────────────────────
# Copy these from Firebase Console → Project Settings → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side only — never expose to client) ────────────────
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Get these from https://cloud.livekit.io → your project → Settings → Keys
#
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET are SERVER-SIDE ONLY.
# They sign JWT tokens in /api/streams/token and /api/livekit/token.
# NEVER prefix them with NEXT_PUBLIC_.
#
# NEXT_PUBLIC_LIVEKIT_URL is the WebSocket URL of your LiveKit server.
# Format: wss://your-project.livekit.cloud

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ── KHOJ AI (server-side only — never expose to client) ───────────────────────
# OPENAI_API_KEY enables live OpenAI responses in /api/ai/khoj-assistant.
# Without it, the route falls back to the mock KHOJ assistant for frontend testing.
OPENAI_API_KEY=
KHOJ_AI_MODEL=gpt-5-mini

# No external vector-store credentials are required for the default MVP setup.
# KHOJ knowledge retrieval reads knowledge/khoj/*.md or knowledge/khoj-index.json.
