# Firebase client config (public, safe for NEXT_PUBLIC)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only, required by API routes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
KHOJ_AI_MODEL=gpt-5-mini

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Feature flags
NEXT_PUBLIC_STARTUP_ROOMS_V1=

# App URL and eSewa payments
NEXT_PUBLIC_APP_URL=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_GATEWAY_URL=
ESEWA_STATUS_CHECK_URL=

# Optional protected env diagnostic route token
ENV_CHECK_TOKEN=
