rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function streamDoc(streamId) {
      return get(/databases/$(database)/documents/streams/$(streamId));
    }

    function isStreamHost(streamId) {
      return isSignedIn() && request.auth.uid == streamDoc(streamId).data.hostId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'ADMIN', 'Admin']
      );
    }

    function isGrowthAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'admin', 'ADMIN', 'Admin',
          'founder', 'FOUNDER', 'Founder',
          'ceo', 'CEO', 'Ceo'
        ]
      );
    }

    function isGrowthContentStatus(status) {
      return status in ['draft', 'approved', 'posted'];
    }

    // ── Users ───────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      // ── Who this user follows ──────────────────────────────────────────────
      match /following/{targetUserId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      // ── Followers of this user ────────────────────────────────────────────
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == followerId;
      }

      // ── Professional mutual connections ───────────────────────────────────
      match /connections/{targetUserId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == targetUserId);
      }
    }

    // ── Notifications ───────────────────────────────────────────────────
    match /notifications/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Tournaments ─────────────────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Opportunity Market ───────────────────────────────────────────────
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.postedBy) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.postedBy) || isAdmin());
    }

    // ── Announcements ───────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Community posts ─────────────────────────────────────────────────
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (isOwner(resource.data.authorId) || isAdmin());
    }

    // ── Community comments ───────────────────────────────────────────────
    match /communityComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (isOwner(resource.data.authorId) || isAdmin());
    }

    // ── Community reports ────────────────────────────────────────────────
    match /communityReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Jobs ─────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (isOwner(resource.data.recruiterId) || isAdmin());
    }

    // ── Project/service marketplace ──────────────────────────────────────
    match /services/{serviceId} {
      allow read: if resource.data.status != 'deleted';
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isSignedIn() &&
        (
          (isOwner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId) ||
          isAdmin()
        );
    }

    match /projects/{projectId} {
      allow read: if resource.data.status != 'deleted';
      allow create: if isSignedIn() && isOwner(request.resource.data.clientId);
      allow update, delete: if isSignedIn() &&
        (
          (isOwner(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId) ||
          isAdmin()
        );
    }

    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.freelancerId) ||
        isOwner(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.clientId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.freelancerId);
      allow update: if isSignedIn() && (
        isOwner(resource.data.freelancerId) ||
        isOwner(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.clientId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Job applications ──────────────────────────────────────────────────
    match /jobApplications/{appId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.applicantId) || isOwner(resource.data.recruiterId) || isAdmin());
      allow create: if isSignedIn() && isOwner(request.resource.data.applicantId);
      allow update: if isSignedIn() &&
        (isOwner(resource.data.applicantId) || isOwner(resource.data.recruiterId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Saved jobs ────────────────────────────────────────────────────────
    match /savedJobs/{savedId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── Job alerts ────────────────────────────────────────────────────────
    match /jobAlerts/{alertId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── Conversations (1-on-1 messages) ──────────────────────────────────────
    // Only participants can read or write the conversation document.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds &&
        // Participants may not change who's in the conversation
        request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // No updates or deletes — messages are immutable once sent.
      }
    }

    // ── Call sessions (LiveKit peer-to-peer) ──────────────────────────────────
    // Only the two parties involved can read or modify a call session.
    match /callSessions/{sessionId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.calleeId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.callerId &&
        request.resource.data.status == 'ringing';
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.calleeId) &&
        // Callee id and caller id cannot be changed after creation
        request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if false; // Audit trail — never delete call sessions
    }

    // ── Friend requests ───────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.fromUserId);
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);
      allow delete: if isSignedIn() &&
        isOwner(resource.data.fromUserId);
    }

    // ── Friends / Connections ─────────────────────────────────────────────
    match /friends/{friendshipId} {
      // Network lists are visible to signed-in users for MVP.
      // resource == null means the document doesn't exist (areFriends check).
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.userIds;
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.userIds;
    }

    // ── Room messages ─────────────────────────────────────────────────────
    match /roomMessages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Matches ───────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Results ───────────────────────────────────────────────────────────
    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Payments / Payouts ────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin();
    }

    // ── Calls (LiveKit 1:1 voice/video) ──────────────────────────────────────
    // Full read/write for any signed-in user.
    // Tighter per-participant rules can be added once calling is stable.
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }

    // ── Live Streams ──────────────────────────────────────────────────────────
    match /streams/{streamId} {
      // Anyone (including guests) can read live streams for the public listing
      allow read: if true;
      // Any signed-in user can create a stream
      allow create: if isSignedIn();
      // Only the host can update their own stream (e.g. end it, change viewerCount)
      allow update: if isSignedIn() && (
        isOwner(resource.data.hostId) ||
        // Allow viewer count and like count updates from any signed-in user
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'likeCount']))
      );
      allow delete: if isSignedIn() && isOwner(resource.data.hostId);

      // ── Stream chat messages ──────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn();
        // Only message author can soft-delete their own message
        allow update: if isSignedIn() && isOwner(resource.data.userId);
        allow delete: if isAdmin();
      }

      // ── Join requests (viewer → host) ─────────────────────────────────────
      // Any signed-in user can read (host needs to list them).
      // Viewer can only create their own request.
      // Any signed-in user can update (host accepts/declines).
      match /joinRequests/{requestId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          isOwner(request.resource.data.userId) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.respondedAt == null;
        allow update: if isStreamHost(streamId);
        allow delete: if isStreamHost(streamId) || isOwner(resource.data.userId);
      }

      // ── Active participants (host + guests) ───────────────────────────────
      // Public read so viewer count / guest list is visible to everyone.
      // Any signed-in user can write (host manages, guests self-register).
      match /participants/{userId} {
        allow read: if true;
        allow create: if isStreamHost(streamId);
        allow update: if isStreamHost(streamId) || isOwner(userId);
        allow delete: if isStreamHost(streamId) || isOwner(userId);
      }

      // ── Stream likes ──────────────────────────────────────────────────────
      // Document ID == userId, so each user has at most one like.
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Global reports ────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Media (videos + clips) ────────────────────────────────────────────
    match /media/{mediaId} {
      allow read: if (resource.data.visibility == 'public' && resource.data.status == 'published')
                   || (isSignedIn() && isOwner(resource.data.creatorId))
                   || isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.creatorId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.creatorId) || isAdmin());

      // ── Comments subcollection ──────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replyCount']);
        allow delete: if isSignedIn() && (
          isOwner(resource.data.authorId) ||
          isOwner(get(/databases/$(database)/documents/media/$(mediaId)).data.creatorId) ||
          isAdmin()
        );

        // Comment likes
        match /likes/{userId} {
          allow read: if true;
          allow write: if isSignedIn() && request.auth.uid == userId;
        }

        // Comment replies
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
          allow delete: if isSignedIn() && (isOwner(resource.data.authorId) || isAdmin());
        }
      }

      // ── Likes subcollection (one doc per user: likes/{userId}) ──────────
      match /likes/{userId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Creator stats ─────────────────────────────────────────────────────
    match /creatorStats/{creatorId} {
      allow read: if isSignedIn() && (request.auth.uid == creatorId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == creatorId;
    }

    // ── Creator settings ──────────────────────────────────────────────────
    match /creatorSettings/{creatorId} {
      allow read, write: if isSignedIn() && request.auth.uid == creatorId;
    }

    // ── Analytics events ──────────────────────────────────────────────────
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // ── Opportunity insights ──────────────────────────────────────────────
    match /opportunityInsights/{creatorId}/items/{itemId} {
      allow read: if isSignedIn() && (request.auth.uid == creatorId || isAdmin());
      allow write: if isAdmin();
    }

    // ── Tracks ────────────────────────────────────────────────────────────
    match /tracks/{trackId} {
      // Public can read published tracks
      allow read: if resource.data.status == 'published' && resource.data.visibility == 'public'
                   || (isSignedIn() && isOwner(resource.data.creatorId))
                   || isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.creatorId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.creatorId) || isAdmin());

      // Lessons subcollection
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isSignedIn() &&
          isOwner(get(/databases/$(database)/documents/tracks/$(trackId)).data.creatorId);
      }

      // Challenges subcollection
      match /challenges/{challengeId} {
        allow read: if true;
        allow write: if isSignedIn() &&
          isOwner(get(/databases/$(database)/documents/tracks/$(trackId)).data.creatorId);
      }

      // Progress subcollection
      match /progress/{userId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          isOwner(get(/databases/$(database)/documents/tracks/$(trackId)).data.creatorId) ||
          isAdmin()
        );
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // Submissions subcollection
      match /submissions/{submissionId} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.userId ||
          isOwner(get(/databases/$(database)/documents/tracks/$(trackId)).data.creatorId) ||
          isAdmin()
        );
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && (
          isOwner(get(/databases/$(database)/documents/tracks/$(trackId)).data.creatorId) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ── User: track enrollments ───────────────────────────────────────────
    match /users/{userId}/trackEnrollments/{trackId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── User: room memberships index ──────────────────────────────────────
    match /users/{userId}/roomMemberships/{roomId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // The accepting founder needs to write to the applicant's roomMemberships
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid
      );
    }

    // ── User: portfolio activities ────────────────────────────────────────
    match /users/{userId}/portfolioActivities/{activityId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ── User: badges ──────────────────────────────────────────────────────
    match /users/{userId}/badges/{badgeId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Leaderboards ──────────────────────────────────────────────────────
    match /leaderboards/{trackId}/users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Collaboration Rooms ────────────────────────────────────────────────
    match /rooms/{roomId} {
      // resource == null when the doc doesn't exist (legacy voice room IDs);
      // allow the read so the SDK returns "not found" instead of throwing.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.visibility == 'public' ||
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
      );
      allow delete: if isAdmin();

      match /members/{userId} {
        // Non-members can read members of public rooms (needed for team tab on discovery)
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'public' ||
          exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        );
        allow create: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow delete: if isAdmin();
      }

      match /roles/{roleId} {
        allow read: if isSignedIn();
        // Allow write if the user has manageRoles permission OR is the room creator
        // (room creator may not yet have their member doc visible to rules right
        //  after a batch commit, so we fall back to the room's createdBy field).
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageRoles == true
        );
      }

      match /roleApplications/{applicationId} {
        // Applicant can read their own; room owner/manager can read all
        allow read: if isSignedIn() && (
          resource.data.applicantId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        // Only signed-in users can apply; they can only create their own application; cannot apply to own room
        allow create: if isSignedIn() &&
          request.resource.data.applicantId == request.auth.uid &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy != request.auth.uid;
        // Only the room owner/manager can update (accept/reject)
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow delete: if false;
      }

      match /joinRequests/{requestId} {
        allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      }

      match /invites/{inviteId} {
        allow read: if isSignedIn() && (
          resource.data.targetUserId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true;
        allow update: if isSignedIn() && resource.data.targetUserId == request.auth.uid;
      }

      match /assets/{assetId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow write: if isSignedIn() &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
      }

      match /sessions/{sessionId} {
        allow read, write: if isSignedIn();
      }

      match /milestones/{milestoneId} {
        allow read, write: if isSignedIn();
      }

      // ── AI Evaluations summary (public + founder/team access) ───────────
      match /aiEvaluations/{evaluationId} {
        // Public can read summary if the room itself is public.
        // Founder / team can always read.
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'public' ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        );
        // Clients do not write directly — the API route writes with Admin SDK.
        allow write: if false;
      }

      // ── Access requests (viewer → founder) ───────────────────────────────
      match /accessRequests/{requestId} {
        // Requester can read their own; room owner/manager can read all
        allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        // Any signed-in user can create their own request (not the room owner)
        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy != request.auth.uid;
        // Only room owner/manager can update (accept/reject)
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow delete: if false;
      }

      // ── Granted access records ────────────────────────────────────────────
      match /access/{userId} {
        // The granted user can read their own access record
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        // Only room owner/manager can create/update access grants
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.permissions.manageMembers == true
        );
        allow delete: if false;
      }
    }

    // ── Startup Profiles ─────────────────────────────────────────────────
    match /startupProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Full KHOJ AI startup evaluations ─────────────────────────────────
    match /startupEvaluations/{evaluationId} {
      // Only the creator / founder can read the full evaluation.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // All writes are server-side via API + Admin SDK.
      allow write: if false;
    }

    // ── KHOJ AI MVP Build packages ────────────────────────────────────────
    // Stores AI-generated MVP build packages for each founder.
    match /khojBuilds/{buildId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ── Internal Growth Studio content ideas ─────────────────────────────
    match /growthContentIdeas/{ideaId} {
      allow read: if isGrowthAdmin();
      allow create: if isGrowthAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGrowthContentStatus(request.resource.data.status);
      allow update: if isGrowthAdmin() &&
        isGrowthContentStatus(request.resource.data.status) &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isGrowthAdmin();
    }

  }
}
